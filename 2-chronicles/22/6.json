{"tier":"glm-5.2","verse":6,"ref":"2-chronicles 22:6","book":"2-chronicles","lang":"sv","chapter":22,"translation":"Och han v\u00e4nde tillbaka f\u00f6r att bli l\u00e4kt i Jisreel, ty \u27e8det var\u27e9 aram\u00e9erna som hade s\u00e5rat honom i Rama, n\u00e4r han stridde \u27e8\u05d0\u05ea\u27e9 mot \u27e8\u05d0\u05ea\u27e9 Chasael, kung av Aram. Och Asarja, son till Jehoram, kung i Juda, gick ned f\u00f6r att se Jehoram, son till Achav, i Jisreel, ty han var sjuk.","tokens":[{"surface":"\u05d5\u05d9\u05e9\u05d1","gloss":"och han v\u00e4nde tillbaka"},{"surface":"\u05dc\u05d4\u05ea\u05e8\u05e4\u05d0","gloss":"f\u00f6r att bli l\u00e4kt"},{"surface":"\u05d1\u05d9\u05d6\u05e8\u05e2\u05d0\u05dc","gloss":"i Jisreel"},{"surface":"\u05db\u05d9","gloss":"ty"},{"surface":"\u05d4\u05de\u05db\u05d9\u05dd","gloss":"de som slog"},{"surface":"\u05d0\u05e9\u05e8","gloss":"vilka"},{"surface":"\u05d4\u05db\u05d4\u05d5","gloss":"hade s\u00e5rat honom"},{"surface":"\u05d1\u05e8\u05de\u05d4","gloss":"i Rama"},{"surface":"\u05d1\u05d4\u05dc\u05d7\u05de\u05d5","gloss":"n\u00e4r han stridde"},{"surface":"\u05d0\u05ea","gloss":"\u27e8\u05d0\u05ea\u27e9 mot"},{"surface":"\u05d7\u05d6\u05d4\u05d0\u05dc","gloss":"Chasael"},{"surface":"\u05de\u05dc\u05da","gloss":"kung"},{"surface":"\u05d0\u05e8\u05dd","gloss":"av Aram"},{"surface":"\u05d5\u05e2\u05d6\u05e8\u05d9\u05d4\u05d5","gloss":"och Asarja"},{"surface":"\u05d1\u05df","gloss":"son till"},{"surface":"\u05d9\u05d4\u05d5\u05e8\u05dd","gloss":"Jehoram"},{"surface":"\u05de\u05dc\u05da","gloss":"kung"},{"surface":"\u05d9\u05d4\u05d5\u05d3\u05d4","gloss":"i Juda"},{"surface":"\u05d9\u05e8\u05d3","gloss":"gick ned"},{"surface":"\u05dc\u05e8\u05d0\u05d5\u05ea","gloss":"f\u00f6r att se"},{"surface":"\u05d0\u05ea","gloss":"\u27e8\u05d0\u05ea\u27e9","marks":"Jehoram"},{"surface":"\u05d9\u05d4\u05d5\u05e8\u05dd","gloss":"Jehoram"},{"surface":"\u05d1\u05df","gloss":"son till"},{"surface":"\u05d0\u05d7\u05d0\u05d1","gloss":"Achav"},{"surface":"\u05d